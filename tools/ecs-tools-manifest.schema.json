{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CST-Cat/ecs/blob/main/tools/ecs-tools-manifest.schema.json",
  "title": "ecs-tools Linux architecture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture",
    "build",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": "ecs-tools.manifest/v1"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "supported_architectures": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/architecture"
      }
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "tools": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/tool"
      },
      "allOf": [
        {"contains": {"properties": {"name": {"const": "sysbench"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "zstd"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "npb-ep"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "npb-ft"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "openssl"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "stream"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "fio"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "iperf3"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "nexttrace-tiny"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "ping"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "architecture": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64",
        "armv7",
        "386",
        "s390x",
        "riscv64",
        "ppc64le"
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        {
          "enum": [
            "unknown",
            "unavailable"
          ]
        }
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "performance_valid"
      ],
      "properties": {
        "scope": {
          "const": "functional"
        },
        "performance_valid": {
          "const": false
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolchain_mode",
        "build_triplet",
        "target_triplet",
        "smoke_runner",
        "validation"
      ],
      "properties": {
        "toolchain_mode": {
          "enum": ["native", "cross"]
        },
        "build_triplet": {
          "type": "string",
          "minLength": 1
        },
        "target_triplet": {
          "type": "string",
          "minLength": 1
        },
        "smoke_runner": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "upstream",
        "version",
        "tag_or_commit",
        "source",
        "build_flags",
        "enabled_features",
        "disabled_features",
        "architecture",
        "license",
        "sha256",
        "parameters"
      ],
      "properties": {
        "name": {
          "enum": [
            "sysbench",
            "zstd",
            "npb-ep",
            "npb-ft",
            "openssl",
            "stream",
            "fio",
            "iperf3",
            "nexttrace-tiny",
            "ping"
          ]
        },
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "tag_or_commit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "build_flags": {
          "$ref": "#/$defs/string_array"
        },
        "enabled_features": {
          "$ref": "#/$defs/string_array"
        },
        "disabled_features": {
          "$ref": "#/$defs/string_array"
        },
        "architecture": {
          "$ref": "#/$defs/architecture"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parameters": {
          "type": "object"
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
